DATABASE_URL=mysql://simple_kanban_service:yourpassword@localhost:3306/simple_kanban_service
SESSION_SECRET=changeme-use-a-long-random-string
PORT=3000
NODE_ENV=development

# Set to true when the app is served over HTTPS, so the session
# cookie carries the Secure flag. Leave false for local http://.
COOKIE_SECURE=false

# Optional. When set, /api/admin/* routes accept requests with
# `Authorization: Bearer <ADMIN_TOKEN>`. When unset, admin routes return 503.
ADMIN_TOKEN=
